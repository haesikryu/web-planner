{
  "openapi": "3.1.1",
  "info": {
    "title": "Web Planner FEAT-001 API",
    "version": "0.2.0",
    "description": "설계 초안. 실행 서버·OAuth 환경은 아직 없다. 모든 제품 API는 동일 출처 HTTPS, 쿠키 세션과 owner 격리를 사용한다. 상세 규칙은 docs/domain/rules.md와 plan.md를 따른다."
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "summary": "현재 사용자·시간대·CSRF 토큰 조회",
        "responses": {
          "200": {
            "description": "개인 캐시 금지 세션 응답",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "summary": "현재 세션 폐기",
        "description": "유효한 세션은 CSRF·Origin 확인 후 폐기. 이미 세션이 없으면 Origin 확인 후 204. 제품 데이터 변경 없음.",
        "security": [],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "유효한 세션이 있을 때 필수다. 세션이 없으면 Origin 확인 후 토큰 없이 204를 반환한다."
          }
        ],
        "responses": {
          "204": {
            "description": "세션 없음. 쿠키 삭제. 응답 본문 없음.",
            "headers": {
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/settings": {
      "patch": {
        "operationId": "patchSettings",
        "summary": "계정 시간대 변경",
        "description": "날짜형 값과 활동의 절대 시각은 유지한다. 최초 로그인에서는 검증된 기기 시간대 제안을 계정 생성에 사용하고 유효한 제안이 없으면 UTC다. 이후 기기가 바뀌어도 자동 변경하지 않으며 이 API로 명시적으로 수정한다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경된 설정",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag。形式は \"v{version}\"。",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "428": {
            "$ref": "#/components/responses/428"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "현재 사용자의 과제 목록",
        "description": "view=inbox는 상태와 관계없이 isUnprocessed=true. scheduled는 open이며 실행일=date. overdue는 open이며 실행일<date. completed는 현재 유효 완료 시각이 계정 시간대의 date에 속함. inbox에서는 date를 생략하고 다른 view에서는 필수로 지정한다. 잘못된 조합은 422. 정렬은 생성 시각 오름차순·ID, completed는 완료 시각 내림차순·ID. 페이지는 스냅샷이 아니므로 변경 후 재조회한다.",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "inbox",
                "scheduled",
                "overdue",
                "completed"
              ],
              "default": "inbox"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "페이지 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskList"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "미완료·미정리 과제 생성",
        "description": "owner는 세션에서 가져온다. 상태는 open, isUnprocessed=true, version=1. 최초와 재생 응답은 모두 같은 201·본문·ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성된 원본",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag。形式は \"v{version}\"。",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/tasks/{taskId}": {
      "get": {
        "operationId": "getTask",
        "summary": "개인 과제 원본과 버전",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "과제 원본",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag。形式は \"v{version}\"。",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "patch": {
        "operationId": "patchTask",
        "summary": "제목·실행일·정리 상태·완료 변경",
        "description": "첫 기능은 open/completed만 변경. completed→open은 완료 취소이며 이전 완료 활동을 무효화한다. 속성 생략은 유지, scheduledDate=null은 날짜 해제. 날짜 변경은 마감일에 영향 없음. 동일 값 변경은 새 버전·활동 없음. 같은 키 재생은 버전 검사 전 처리하며 사용자 소유권은 먼저 확인한다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchTask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경된 원본 또는 동일 요청 재생",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag。形式は \"v{version}\"。",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "428": {
            "$ref": "#/components/responses/428"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-planner-session"
      }
    },
    "parameters": {
      "TaskId": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "사용자·메서드·경로 범위의 키. 24시간 재생. 다른 본문/If-Match로 재사용 시 409."
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"v[1-9][0-9]*\"$"
        },
        "description": "원본 버전의 단일 strong ETag. 누락 428, 형식 오류 422, 버전 불일치 412."
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "GET /api/session에서 받은 현재 세션의 토큰. Origin 검사를 함께 적용."
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "NFC 정규화·Unicode 앞뒤 공백 제거 후 1~200 코드 포인트. CR·LF·NUL 금지."
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "completed"
            ]
          },
          "scheduledDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "readOnly": true,
            "description": "첫 기능에서 변경하지 않는 마감일"
          },
          "isUnprocessed": {
            "type": "boolean"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "scheduledDate",
          "dueDate",
          "isUnprocessed",
          "completedAt",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "NFC 정규화·Unicode 앞뒤 공백 제거 후 1~200 코드 포인트. CR·LF·NUL 금지."
          },
          "scheduledDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          }
        },
        "required": [
          "title"
        ]
      },
      "PatchTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "NFC 정규화·Unicode 앞뒤 공백 제거 후 1~200 코드 포인트. CR·LF·NUL 금지."
          },
          "scheduledDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "completed"
            ]
          },
          "isUnprocessed": {
            "type": "boolean"
          }
        },
        "required": [],
        "minProperties": 1
      },
      "TaskList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "serverDate": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "serverDate",
          "timezone"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "timezone": {
            "type": "string",
            "description": "검증된 IANA 시간대"
          },
          "settingsVersion": {
            "type": "integer",
            "minimum": 1
          },
          "serverDate": {
            "type": "string",
            "format": "date"
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "userId",
          "timezone",
          "settingsVersion",
          "serverDate",
          "csrfToken"
        ]
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "timezone",
          "version"
        ]
      },
      "PatchSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "type": "string",
            "minLength": 1,
            "description": "서버가 지원하는 IANA 시간대. 유효하지 않으면 422."
          }
        },
        "required": [
          "timezone"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      }
    },
    "responses": {
      "401": {
        "description": "미인증 또는 세션 만료",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "403": {
        "description": "CSRF 또는 Origin 검증 실패",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "404": {
        "description": "항목 없음 또는 다른 사용자 소유",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "409": {
        "description": "IDEMPOTENCY_KEY_REUSED 또는 REQUEST_IN_PROGRESS",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "재시도 가능한 처리중·요청 제한 응답에서 제공하는 초 단위 대기 시간. 키 본문 충돌에서는 생략.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
