{
  "openapi": "3.1.1",
  "info": {
    "title": "Web Planner FEAT-001 API",
    "version": "0.6.0",
    "description": "FEAT-001 실행 계약. 인증·설정·과제와 날짜별 자유글 API를 제공한다. 실제 Google 공급자 검증과 배포 상태는 별도 검증 기록을 따른다."
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "summary": "현재 사용자·시간대·CSRF 토큰 조회",
        "responses": {
          "200": {
            "description": "개인 캐시 금지 세션 응답",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "summary": "현재 세션 폐기",
        "description": "유효한 세션은 CSRF·Origin 확인 후 폐기. 이미 세션이 없으면 Origin 확인 후 204. 제품 데이터 변경 없음.",
        "security": [],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "유효한 세션이 있을 때 필수다. 세션이 없으면 Origin 확인 후 토큰 없이 204를 반환한다."
          }
        ],
        "responses": {
          "204": {
            "description": "세션 없음. 쿠키 삭제. 응답 본문 없음.",
            "headers": {
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/settings": {
      "patch": {
        "operationId": "patchSettings",
        "summary": "계정 시간대 변경",
        "description": "날짜형 값과 활동의 절대 시각은 유지한다. 최초 로그인에서는 검증된 기기 시간대 제안을 계정 생성에 사용하고 유효한 제안이 없으면 UTC다. 이후 기기가 바뀌어도 자동 변경하지 않으며 이 API로 명시적으로 수정한다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경된 설정",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag. 형식은 v 뒤에 버전을 붙이고 큰따옴표로 감싼다.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "428": {
            "$ref": "#/components/responses/428"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "현재 사용자의 과제 목록",
        "description": "view=inbox는 상태와 관계없이 isUnprocessed=true. scheduled는 completed를 제외한 상태이며 실행일=date로 취소 표시도 유지한다. overdue는 open/deferred이며 실행일<date. completed는 현재 유효 완료 시각이 계정 시간대의 date에 속함. inbox에서는 date를 생략하고 다른 view에서는 필수로 지정한다. 잘못된 조합은 422. 정렬은 생성 시각 오름차순·ID, completed는 완료 시각 내림차순·ID. 페이지는 스냅샷이 아니므로 변경 후 재조회한다.",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "inbox",
                "scheduled",
                "overdue",
                "completed"
              ],
              "default": "inbox"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "페이지 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskList"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "미완료·미정리 과제 생성",
        "description": "owner는 세션에서 가져온다. 상태는 open, isUnprocessed=true, version=1. 최초와 재생 응답은 모두 같은 201·본문·ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성된 원본",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag. 형식은 v 뒤에 버전을 붙이고 큰따옴표로 감싼다.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/tasks/{taskId}": {
      "get": {
        "operationId": "getTask",
        "summary": "개인 과제 원본과 버전",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "과제 원본",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag. 형식은 v 뒤에 버전을 붙이고 큰따옴표로 감싼다.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "patch": {
        "operationId": "patchTask",
        "summary": "제목·실행일·정리 상태·완료 변경",
        "description": "상태 open/completed/deferred/canceled와 우선순위 high/medium/low, 유형 task/appointment/event를 변경한다. completed에서 어떤 다른 상태로 이동해도 완료 시각과 이전 유효 완료 활동을 무효화한다. 미룸은 상태 표시만 바꾸며 날짜 이동은 scheduledDate를 명시한다. 속성 생략은 유지, scheduledDate=null은 날짜 해제. 날짜 변경은 마감일에 영향 없음. 동일 값 변경은 새 버전·활동 없음. 같은 키 재생은 버전 검사 전 처리하며 사용자 소유권은 먼저 확인한다. 변경 결과가 날짜 없는 비완료 항목이면 입력함 접근을 유지하도록 isUnprocessed=true를 보충한다. 이 조건에서 명시적인 isUnprocessed=false는 422이며, 서버 보충값은 원래 요청의 재생 해시에 포함하지 않는다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchTask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경된 원본 또는 동일 요청 재생",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "단일 strong ETag. 형식은 v 뒤에 버전을 붙이고 큰따옴표로 감싼다.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "개인 데이터·세션 응답은 no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "428": {
            "$ref": "#/components/responses/428"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/api/journal/{date}": {
      "get": {
        "operationId": "getJournal",
        "summary": "선택 날짜의 개인 자유글 조회",
        "description": "세션의 owner와 날짜로 조회한다. 글이 없으면 행을 생성하지 않고 {date,content:\"\",version:0,updatedAt:null}을 반환한다. 다른 사용자의 같은 날짜 글은 노출하지 않는다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JournalDate"
          }
        ],
        "responses": {
          "200": {
            "description": "선택 날짜의 개인 자유글. 빈 날짜도 200과 ETag \"v0\"로 응답한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalEntry"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "version 0을 허용하는 단일 strong ETag.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v(?:0|[1-9][0-9]*)\"$"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "put": {
        "operationId": "putJournal",
        "summary": "선택 날짜의 개인 자유글 저장",
        "description": "세션의 owner와 날짜별로 본문을 저장한다. JSON 본문은 최대 65536바이트로 제한한다. 변경 후 본문이 같으면 버전·시각을 유지하며, 빈 날짜에 빈 글을 저장하는 것도 v0의 no-op이다. 저장된 글은 빈 문자열로 비울 수 있으며 행을 삭제하거나 버전을 초기화하지 않는다. 동일 요청 키는 24시간 동안 버전 검사 전에 성공 결과를 재생하고 내용 또는 If-Match가 다르면 409다. 같은 날짜 첫 저장도 직렬화하여 오래된 버전은 412로 거절하며 잠금 대기 초과는 재시도 가능한 409다. 제목·할 일·시간대 등 다른 자료는 변경하지 않는다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JournalDate"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/JournalIfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutJournal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "선택 날짜의 개인 자유글. 빈 날짜도 200과 ETag \"v0\"로 응답한다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalEntry"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "version 0을 허용하는 단일 strong ETag.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v(?:0|[1-9][0-9]*)\"$"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "428": {
            "$ref": "#/components/responses/428"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-planner-session"
      }
    },
    "parameters": {
      "TaskId": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "사용자·메서드·경로 범위의 키. 24시간 재생. 다른 본문/If-Match로 재사용 시 409."
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"v[1-9][0-9]*\"$"
        },
        "description": "원본 버전의 단일 strong ETag. 누락 428, 형식 오류 422, 버전 불일치 412."
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "GET /api/session에서 받은 현재 세션의 토큰. Origin 검사를 함께 적용."
      },
      "JournalDate": {
        "name": "date",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "date",
          "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}$"
        },
        "description": "시간대 변환 없는 0001-01-01~9999-12-31의 실제 달력 날짜. 잘못된 날짜는 422."
      },
      "JournalIfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"v(?:0|[1-9][0-9]*)\"$"
        },
        "description": "날짜별 글의 단일 strong ETag. 아직 저장한 글이 없으면 \"v0\", 저장된 글은 \"vN\". 버전은 0~2147483646. 누락 428, 형식 오류 422, 버전 불일치 412."
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "description": "설정된 서비스 origin과 일치해야 한다. 누락하거나 다르면 403."
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "NFC 정규화·Unicode 앞뒤 공백 제거 후 1~200 코드 포인트. CR·LF·NUL 금지."
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "completed",
              "deferred",
              "canceled"
            ],
            "description": "미완료, 완료(✓), 미룸(→), 취소(×). 미룸은 표시만 바꾸며 실행일은 유지한다."
          },
          "scheduledDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "readOnly": true,
            "description": "첫 기능에서 변경하지 않는 마감일"
          },
          "isUnprocessed": {
            "type": "boolean"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "우선순위: 상·중·하. 생략한 신규 과제는 medium."
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "appointment",
              "event"
            ],
            "description": "기호 유형: 할 일(□), 약속(△), 행사(○). 생략한 신규 과제는 task."
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "scheduledDate",
          "dueDate",
          "isUnprocessed",
          "completedAt",
          "version",
          "createdAt",
          "updatedAt",
          "priority",
          "kind"
        ]
      },
      "CreateTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "NFC 정규화·Unicode 앞뒤 공백 제거 후 1~200 코드 포인트. CR·LF·NUL 금지."
          },
          "scheduledDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "우선순위: 상·중·하. 생략한 신규 과제는 medium.",
            "default": "medium"
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "appointment",
              "event"
            ],
            "description": "기호 유형: 할 일(□), 약속(△), 행사(○). 생략한 신규 과제는 task.",
            "default": "task"
          }
        },
        "required": [
          "title"
        ]
      },
      "PatchTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "NFC 정규화·Unicode 앞뒤 공백 제거 후 1~200 코드 포인트. CR·LF·NUL 금지."
          },
          "scheduledDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "completed",
              "deferred",
              "canceled"
            ],
            "description": "미완료, 완료(✓), 미룸(→), 취소(×). 미룸은 표시만 바꾸며 실행일은 유지한다."
          },
          "isUnprocessed": {
            "type": "boolean",
            "description": "변경 결과가 completed가 아니고 scheduledDate=null이면 false 지정은 422. 생략하면 true로 보충하여 입력함에 남긴다."
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "우선순위: 상·중·하. 생략한 신규 과제는 medium."
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "appointment",
              "event"
            ],
            "description": "기호 유형: 할 일(□), 약속(△), 행사(○). 생략한 신규 과제는 task."
          }
        },
        "required": [],
        "minProperties": 1
      },
      "TaskList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "serverDate": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "serverDate",
          "timezone"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "timezone": {
            "type": "string",
            "description": "검증된 IANA 시간대"
          },
          "settingsVersion": {
            "type": "integer",
            "minimum": 1
          },
          "serverDate": {
            "type": "string",
            "format": "date"
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "userId",
          "timezone",
          "settingsVersion",
          "serverDate",
          "csrfToken"
        ]
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "timezone",
          "version"
        ]
      },
      "PatchSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "type": "string",
            "minLength": 1,
            "description": "서버가 지원하는 IANA 시간대. 유효하지 않으면 422."
          }
        },
        "required": [
          "timezone"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "JournalEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}$"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "pattern": "^[^\\u0000]*$",
            "description": "CRLF를 LF로 바꾼 후 최대 10000 Unicode 코드 포인트. 빈 문자열 허용, NUL 금지. 나머지 공백·줄바꿈·Unicode 정규화 형태는 보존하며 trim이나 NFC 정규화하지 않는다."
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "date",
          "content",
          "version",
          "updatedAt"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "version": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "const": ""
                },
                "updatedAt": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ],
        "description": "조회 시 기록이 없으면 빈 content·version 0·updatedAt null. owner는 응답에 포함하지 않는다."
      },
      "PutJournal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 20000,
            "pattern": "^[^\\u0000]*$",
            "description": "CRLF를 LF로 바꾼 후 최대 10000 Unicode 코드 포인트. 빈 문자열 허용, NUL 금지. 나머지 공백·줄바꿈·Unicode 정규화 형태는 보존하며 trim이나 NFC 정규화하지 않는다. 요청 원문은 CRLF 10000쌍을 허용하므로 길이 상한 20000이며 정규화 후 10000 상한을 추가 검사한다."
          }
        },
        "required": [
          "content"
        ]
      }
    },
    "responses": {
      "401": {
        "description": "미인증 또는 세션 만료",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "403": {
        "description": "CSRF 또는 Origin 검증 실패",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "404": {
        "description": "항목 없음 또는 다른 사용자 소유",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "409": {
        "description": "IDEMPOTENCY_KEY_REUSED 또는 REQUEST_IN_PROGRESS",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "재시도 가능한 처리중·요청 제한 응답에서 제공하는 초 단위 대기 시간. 키 본문 충돌에서는 생략.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "412": {
        "description": "VERSION_CONFLICT. 최신 원본을 다시 조회",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "422": {
        "description": "VALIDATION_ERROR. 날짜·본문·헤더·조회 조합 확인",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "428": {
        "description": "PRECONDITION_REQUIRED. If-Match 필요",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "429": {
        "description": "RATE_LIMITED. 잠시 후 재시도",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "재시도 가능한 처리중·요청 제한 응답에서 제공하는 초 단위 대기 시간. 키 본문 충돌에서는 생략.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "500": {
        "description": "INTERNAL_ERROR. 저장 여부 불확실 시 동일 키 재시도",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "503": {
        "description": "인증 설정·인증 또는 DB 연결을 사용할 수 없음. 비밀값 없는 오류와 no-store 반환.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      },
      "400": {
        "description": "다른 사용자·조회 조건 또는 변조된 목록 커서",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
