# Local-only development examples. Replace placeholders in an ignored .env.local.
# Do not put real secrets or production URLs in this file.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact verified Google email allowlist. Empty configuration disables authentication.
AUTH_ALLOWED_EMAILS=
# Enable only after configuring the private beta owner's allowlist.
AUTH_ALLOW_SIGN_UP=false
DATABASE_URL=postgresql://planner_local:planner_local_only@127.0.0.1:54329/planner_local
