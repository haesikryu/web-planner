# Local-only development examples. Replace placeholders in an ignored .env.local.
# Do not put real secrets or production URLs in this file.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep false until the initial service audience (D-01) has been decided.
AUTH_ALLOW_SIGN_UP=false
DATABASE_URL=postgresql://planner_local:planner_local_only@127.0.0.1:54329/planner_local
